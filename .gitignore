# 이 저장소에는 "소스"만 들어간다.
# 설치·빌드·실행 과정에서 로컬에 생기는 것은 전부 여기서 막는다.

# ---------- 의존성 ----------
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# ---------- 빌드 산출물 ----------
# dist가 실제 배포되는 결과물. 빌드로 언제든 다시 만들 수 있으므로 커밋하지 않는다.
dist
dist-ssr
build
out

# ---------- 캐시 ----------
.vite
.cache
.parcel-cache
.turbo
.rollup.cache
.eslintcache
.oxlintcache
.stylelintcache
*.tsbuildinfo

# ---------- 테스트 ----------
coverage
.nyc_output
playwright-report
test-results
blob-report
.playwright

# ---------- 환경변수 ----------
# .env.example만 커밋한다. 실제 값이 든 파일은 절대 올리지 않는다.
.env
.env.*
!.env.example

# ---------- 로그 ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm

# ---------- 배포 플랫폼 ----------
.vercel
.netlify
.firebase
.wrangler

# ---------- 에디터 / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea
.fleet
.history
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---------- 기타 로컬 ----------
*.local
tmp
temp
.env*
